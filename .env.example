# Copy this file to .env and fill in real values.
# Never commit .env — it's in .gitignore for a reason.

# Generate a real one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

DATABASE_URL=sqlite:///errandly.db

# Set to True only for local development. Never True in production.
FLASK_DEBUG=False

# Set to True once deployed behind HTTPS. Keep False for local http dev.
SESSION_COOKIE_SECURE=False

# Paystack (get these from your Paystack dashboard -> Settings -> API Keys)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# After deploying, add https://yourdomain.com/payment/webhook as a
# webhook URL in the Paystack dashboard (Settings -> API Keys &
# Webhooks). No extra secret needed here - the webhook is verified
# using PAYSTACK_SECRET_KEY above.

# Twilio (SMS / WhatsApp)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
